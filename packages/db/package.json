{
	"name": "@pcadvisor/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"db:migrate": "tsx src/cli.ts db:migrate",
		"import:csv": "tsx src/cli.ts import:csv",
		"seed:components": "tsx src/cli.ts seed:components",
		"apply:mappings": "tsx src/cli.ts apply:mappings",
